$! HTTPD_CONFIG.COM - the settings HTTPD.EXE reads (logical names).  Edit to suit.
$! HTTPD_RUN.COM runs this before it starts the server.
$ DEFINE/NOLOG HTTPD_PORT 80
$ DEFINE/NOLOG HTTPD_ROOT "CPVAX$DUA1:[LIGHTTPD.WWW]"
$ DEFINE/NOLOG HTTPD_TMP  "CPVAX$DUA1:[LIGHTTPD.TMP]"
$ DEFINE/NOLOG HTTPD_PERL "CPVAX$DUA1:[P]PERL.EXE"
$ DEFINE/NOLOG HTTPD_PERL_SETUP "CPVAX$DUA1:[P]PERL_SETUP.COM"
$ DEFINE/NOLOG HTTPD_CGI  "CPVAX$DUA1:[LIGHTTPD.BIN]HTTPD_CGI.COM"
$! HTTPD_USERDIR is the sub-directory of [name] that /~name/ shows (default WEB)
$ EXIT
