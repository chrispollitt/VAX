# Copy to ~/.config/waxweb.env on the web host, then:  chmod 600 ~/.config/waxweb.env
# Where the VAX's telnet appears from the web host (the far end of the ssh tunnel):
VAX_HOST=127.0.0.1
VAX_PORT=2323
# The dedicated low-privilege VMS account (see vms_account.txt):
VAX_USER=WAXWEB
VAX_PASS=put-the-real-password-here
# Directory on the VAX that holds RUN_WAXR.COM:
VAX_WAXDIR=DUA1:[SYSTEM.WAXR]
# Web UI:
WAXWEB_BIND=0.0.0.0
WAXWEB_PORT=8088
# Optional HTTP basic auth for the web UI:
#WAXWEB_AUTH=user:choose-something
