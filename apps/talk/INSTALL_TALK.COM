$ ! INSTALL_TALK.COM - put TALK and PHONE in CPVAX$DUA1:[TALK] and show the SYLOGIN line that turns them on
$ ! Run as SYSTEM from the directory that holds TALK.COM, PHONE.COM and TALK_SETUP.COM:  @INSTALL_TALK
$ ! (TCPware's TALKD must also be enabled: TALKD_ENABLE == 1 in SYS$SPECIFIC:[TCPWARE]TCPWARE_CONFIGURE.COM,
$ !  started with  @TCPWARE:TALK_CONTROL STARTUP  until the next boot does it.)
$ SET NOON
$ TARGET = "CPVAX$DUA1:[TALK]"
$ IF F$SEARCH("CPVAX$DUA1:[000000]TALK.DIR") .EQS. "" THEN CREATE/DIRECTORY 'TARGET'/PROTECTION=(S:RWE,O:RWE,G:RE,W:RE)
$ COPY TALK.COM,PHONE.COM,TALK_SETUP.COM 'TARGET'/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE)
$ PURGE 'TARGET'*.COM
$ DIRECTORY 'TARGET'
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Add to SYS$MANAGER:SYLOGIN.COM (in the 'ADD COMMANDS' block, after @TCPWARE:TCPWARE_COMMANDS ran):"
$ WRITE SYS$OUTPUT "$ IF F$SEARCH(""CPVAX$DUA1:[TALK]TALK_SETUP.COM"") .NES. """" THEN @CPVAX$DUA1:[TALK]TALK_SETUP"
$ EXIT
