# Copy to ~/.config/waxweb.env on cpbee, then:  chmod 600 ~/.config/waxweb.env
# (POSIX/web-ttyd/install.sh refuses to start waxweb until that file exists and is mode 600.)
# The password is the only thing that has to be filled in; the rest are the cpbee defaults.

# Where OpenVMS answers telnet (the cpvax):
VAX_HOST=192.168.20.30
VAX_PORT=23
# The dedicated low-privilege VMS account (see vms_account.txt):
VAX_USER=WAXWEB
VAX_PASS=put-the-real-password-here
# The VAX is on demand (off until powered on, off again when idle): its systemd unit, so waxweb can tell
# "powered off" from "still booting" and offer a Power on button.  Remove if the VAX is always on.
VAX_UNIT=vax.service
# Log out of VMS when nobody has used the session for this many seconds (0 = never):
VAX_SESSION_IDLE=600
# Directory on the VAX that holds RUN_WAXR.COM:
VAX_WAXDIR=DUA1:[SYSTEM.WAXR]
# The web UI listens on 127.0.0.1:8088 (the unit sets this); nginx serves it at https://192.168.10.1:8444/waxweb/
# with the web-ttyd password.  Do not set WAXWEB_AUTH as well: nginx has already authenticated the request.
