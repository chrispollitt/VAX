def log(msg):
    print(msg, flush=True)


def read_kv(path):
    out = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except IOError:
        pass
    return out


def load_conf(path=None):
    cfg = dict(DEFAULTS)
    for k, v in read_kv(path or CONF).items():
        if k in DEFAULTS:
            cfg[k] = type(DEFAULTS[k])(v)
    return cfg


# ---------------------------------------------------------------- the idle decision (pure, tested)

def step(state, cur, cfg):
    """state: {'last': previous sample, 'idle_since': epoch or None}; cur: {'t','cpu_s','net_b','age_s'}.
    Returns (new state, info) with info = {'busy', 'why', 'idle_min', 'cpu_pct', 'net_per_min'}."""
    state = dict(state)
    last = state.get("last")
    state["last"] = cur
    info = {"busy": True, "why": "", "idle_min": 0.0, "cpu_pct": None, "net_per_min": None}
    if cur["age_s"] < cfg["STARTUP_GRACE_MINUTES"] * 60:
        state["idle_since"] = None
        info["why"] = "starting up"
        return state, info
    if not last or cur["t"] <= last["t"]:
        state["idle_since"] = None
        info["why"] = "first sample"
        return state, info
    dt = cur["t"] - last["t"]
    cpu_pct = 100.0 * (cur["cpu_s"] - last["cpu_s"]) / dt
    net_pm = 60.0 * (cur["net_b"] - last["net_b"]) / dt
    info["cpu_pct"], info["net_per_min"] = cpu_pct, net_pm
    if cpu_pct > cfg["CPU_PCT_MAX"]:
        info["why"] = "cpu %.1f%%" % cpu_pct
    elif net_pm > cfg["NET_BYTES_PER_MIN_MAX"]:
        info["why"] = "network %d bytes/min" % net_pm
    else:
        info["busy"] = False
    if info["busy"]:
        state["idle_since"] = None
    else:
        if state.get("idle_since") is None:
            state["idle_since"] = last["t"]
        info["idle_min"] = (cur["t"] - state["idle_since"]) / 60.0
    return state, info


# ---------------------------------------------------------------- the host

def systemctl(*args):
    return subprocess.run(SYSTEMCTL + list(args), stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)


def unit_active(cfg):
    return systemctl("is-active", "--quiet", cfg["UNIT"]).returncode == 0


def main_pid(cfg):
    out = systemctl("show", "-p", "MainPID", "--value", cfg["UNIT"]).stdout.strip()
    return int(out) if out.isdigit() else 0


def proc_stat(pid):
    with open("%s/%d/stat" % (PROC, pid)) as f:
        return f.read().rsplit(")", 1)[1].split()           # field N of proc(5) is rest[N-3]


def uptime():
    with open("%s/uptime" % PROC) as f:
        return float(f.read().split()[0])


def proc_age(pid):
    """Seconds since the process started."""
    return uptime() - int(proc_stat(pid)[19]) / float(os.sysconf("SC_CLK_TCK"))


def sample(cfg, pid):
    """cpu seconds and age of the simh process, bytes over the tap interface, now."""
    hz = os.sysconf("SC_CLK_TCK")
    rest = proc_stat(pid)
    cpu_s = (int(rest[11]) + int(rest[12])) / float(hz)      # utime + stime
    start_s = int(rest[19]) / float(hz)                      # starttime, since boot
    up = uptime()
    nb = 0
    for d in ("rx_bytes", "tx_bytes"):
        with open("%s/class/net/%s/statistics/%s" % (SYS, cfg["NET_IF"], d)) as f:
            nb += int(f.read())
    return {"t": time.time(), "cpu_s": cpu_s, "net_b": nb, "age_s": up - start_s}


def load_state(path=None):
    try:
        with open(path or STATE) as f:
            return json.load(f)
    except (IOError, ValueError):
        return {}


def save_state(state, path=None):
    path = path or STATE
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, path)


def port_open(host, port, timeout=2.0):
    try:
        socket.create_connection((host, port), timeout).close()
        return True
    except (OSError, socket.timeout):
        return False


# ---------------------------------------------------------------- a minimal telnet client, for the SHUTDOWN login

IAC, DONT, DO, WONT, WILL, SB, SE = 255, 254, 253, 252, 251, 250, 240


class Telnet(object):
    def __init__(self, host, port, timeout=10):
        self.sock = socket.create_connection((host, port), timeout)
        self.buf = ""
        self.pending = b""
        self.eof = False

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass

    def _strip(self, data):
        """Remove telnet commands (refusing every option: plain line mode is all a DCL login needs)."""
        data = self.pending + data
        out, i, n = bytearray(), 0, len(data)
        while i < n:
            b = data[i]
            if b != IAC:
                if b != 0:
                    out.append(b)
                i += 1
            elif i + 1 >= n:
                break
            elif data[i + 1] == IAC:
                out.append(255)
                i += 2
            elif data[i + 1] in (DO, DONT, WILL, WONT):
                if i + 2 >= n:
                    break
                if data[i + 1] == DO:
                    self.sock.sendall(bytes([IAC, WONT, data[i + 2]]))
                elif data[i + 1] == WILL:
                    self.sock.sendall(bytes([IAC, DONT, data[i + 2]]))
                i += 3
            elif data[i + 1] == SB:
                j = data.find(bytes([IAC, SE]), i + 2)
                if j < 0:
                    break
                i = j + 2
            else:
                i += 2
        self.pending = bytes(data[i:])
        return out.decode("latin-1")

    def _pump(self, wait):
        if self.eof:
            return
        r, _, _ = select.select([self.sock], [], [], wait)
        if r:
            data = self.sock.recv(4096)
            if not data:
                self.eof = True
            else:
                self.buf += self._strip(data)

    def expect(self, patterns, timeout):
        """First of `patterns` (compiled regexes) to match in the incoming text: (index, text up to and including
        it).  (None, text) at end of connection; raises socket.timeout."""
        deadline = time.time() + timeout
        while True:
            best = None
            for i, p in enumerate(patterns):
                m = p.search(self.buf)
                if m and (best is None or m.start() < best[1].start()):
                    best = (i, m)
            if best:
                text, self.buf = self.buf[:best[1].end()], self.buf[best[1].end():]
                return best[0], text
            if self.eof:
                text, self.buf = self.buf, ""
                return None, text
            left = deadline - time.time()
            if left <= 0:
                raise socket.timeout("no match for %s" % [p.pattern for p in patterns])
            self._pump(min(left, 1.0))

    def read_quiet(self, quiet, limit, sink=None):
        """Everything that arrives until the line has been silent for `quiet` seconds, the connection ends, or
        `limit` seconds have passed.  `sink(text)` is called with each piece as it comes."""
        end = last = time.time()
        end += limit
        got = []
        while not self.eof:
            now = time.time()
            if now >= end or now - last >= quiet:
                break
            before = len(self.buf)
            self._pump(min(quiet - (now - last), end - now, 1.0))
            if len(self.buf) > before:
                last = time.time()
                piece, self.buf = self.buf, ""
                got.append(piece)
                if sink:
                    sink(piece)
        return "".join(got)

    def send(self, text):
        self.sock.sendall(text.encode("latin-1") + b"\r\0")      # Enter, as a telnet client sends it


def _clean(text):
    return re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", text).strip()


# SHUTDOWN.COM asks these, in this order, and takes the default (shown here as "") for the rest
SHUTDOWN_PROMPTS = [
    (r"do you really want to shutdown", "YES"),     # the first question on cpvax (found 2026-10-29); the default is NO
    (r"how many minutes until final shutdown", "{minutes}"),
    (r"reason for shutdown", "{reason}"),
    (r"spin down the disk volumes", "NO"),
    (r"site-specific shutdown procedure", "YES"),
    (r"automatic system reboot", "NO"),
    (r"when will the system be rebooted", ""),       # asked even after NO above (found 2026-10-29); the default is "later"
    (r"shutdown options", ""),
]
MAX_UNKNOWN = 6                                      # unlisted questions answered with their default before giving up


def loose(phrase):
    """A regex for `phrase` that still matches when the terminal has wrapped the line in the middle of a word: cpvax
    printed "How many minutes until final shu<CR><LF>tdown [0]: " (2026-10-29), which a plain match never found.  Any
    whitespace may sit between two letters."""
    return r"\s*".join(re.escape(ch) for ch in phrase if not ch.isspace())


LOGIN_QUIET = 4.0                                    # seconds of silence that end "VMS is still logging us in"
SETTLE = 1.0                                         # seconds of silence that mean a SHUTDOWN question is complete
MARKER_COMMAND = 'WRITE SYS$OUTPUT F$FAO("VAXCTL-!AS","OK")'      # prints VAXCTL-OK; its echo does not contain that text
MARKER_REPLY = "VAXCTL-OK"
MARKER_TRIES = 4                                     # t_login is split between these


def vms_shutdown(host, port, user, secret, minutes, reason, t_login=60, t_down=None, t_quiet=LOGIN_QUIET,
                 t_progress=30.0, t_settle=SETTLE, command="SHUTDOWN"):
    """Log in to OpenVMS and run `command`: cpvax's own SHUTDOWN command, which asks one question ("Do you really want
    to shutdown node CPVAX [NO]?") and takes the defaults for the rest, as typed by hand on 2026-10-29.  (The plain
    @SYS$SYSTEM:SHUTDOWN, with no parameters, interviews at length; the dialogue below copes with that too.)
    True once VMS has gone down (the connection closed or it
    said so); False on anything unexpected, with the transcript logged (never the password).  After the last
    prompt VMS is silent for the whole warning period, so the only bound is one deadline: the warning plus 5 minutes.

    Whether the login worked is not judged from a "$ " prompt: on cpvax the login procedure runs SET TERMINAL/INQUIRE
    (two terminal queries that nobody answers) and the DCL prompt is `CPVAX$DUA1:[SYSTEM]`, so no fixed prompt can be
    relied on (the first real shutdown, 2026-10-29, waited for "$ " and timed out).  Instead: wait until VMS has been
    quiet for `t_quiet` seconds after the password, give up if a login failure came, and otherwise type a command that
    prints a marker and wait for that."""
    t_down = t_down if t_down is not None else minutes * 60 + 300
    rx = lambda s: re.compile(s, re.I)
    login_bad = rx(r"%LOGIN-F|invalid password|user authorization failure|login incorrect")
    marker = rx(re.escape(MARKER_REPLY))
    seen = ""                                        # what VMS sent after the password, for the log if it goes wrong

    def redact(s):                                   # the password is blanked in case anything echoed it
        return s.replace(secret, "<password>") if secret else s
    prompts = [rx(loose(p)) for p, _ in SHUTDOWN_PROMPTS]
    done = rx("|".join([loose("shutdown complete"), loose("system halted"), "halting"]))
    last_answered = -1                               # index of the furthest SHUTDOWN question answered
    # VMS prints %SHUTDOWN-I-... lines once the questions are over and it is shutting down.  Any other question that
    # shows its default ("[later]: ") is answered with that default, so a SHUTDOWN.COM that asks one more thing than
    # this program knows (cpvax asked "When will the system be rebooted" after a NO) does not stall it.
    started = rx(r"%SHUTDOWN-I-")
    unknown = rx(r"\[[^\]\r\n]{1,30}\]\s*[:?]\s*$")
    shutdown_started = False
    answered_unknown = 0
    try:
        t = Telnet(host, port)
    except OSError as e:
        log("shutdown: cannot connect to %s:%s: %s" % (host, port, e))
        return False
    try:
        i, text = t.expect([rx(r"username:")], t_login)
        if i is None:
            log("shutdown: connection closed before the login prompt")
            return False
        log("vms> " + _clean(text)[-200:])
        t.send(user)
        t.expect([rx(r"password:")], t_login)
        log("vms> (sending the password)")
        t.send(secret)
        seen = t.read_quiet(t_quiet, t_login)
        log("vms> " + redact(_clean(seen)[-300:]))
        if login_bad.search(seen):
            log("shutdown: VMS login failed")
            return False
        if t.eof:
            log("shutdown: VMS closed the connection after the password")
            return False
        # The login procedure may still be running when VMS goes quiet: cpvax's runs SET TERMINAL/INQUIRE, which asks
        # the terminal who it is and waits for a reply that never comes, and it swallowed the first marker command as
        # that reply (2026-10-29: no echo, no answer).  So ask again until VMS answers; the command is harmless to repeat.
        for attempt in range(1, MARKER_TRIES + 1):
            t.send(MARKER_COMMAND)
            try:
                i, _ = t.expect([marker], t_login / float(MARKER_TRIES))
            except socket.timeout:
                if attempt == MARKER_TRIES:
                    raise
                log("vms> no answer to the marker command yet (try %d of %d): the login procedure may still be running"
                    % (attempt, MARKER_TRIES))
                continue
            if i is None:
                log("shutdown: VMS closed the connection before it answered the marker command")
                return False
            break
        log("vms> logged in (the marker command was answered, try %d)" % attempt)
        t.send(command)
        deadline = time.time() + t_down
        while True:
            left = deadline - time.time()
            if left <= 0:
                raise socket.timeout("VMS did not go down within %d s" % t_down)
            n = len(prompts)
            try:
                i, text = t.expect(prompts + [done, started, unknown], min(left, t_progress))
            except socket.timeout:
                # still waiting: say what has arrived so far, so a stall can be diagnosed while it is happening
                log("vms> still waiting for a SHUTDOWN question or the end (%d s left); nothing matched yet; text so far: %r"
                    % (left, redact(t.buf[-300:])))
                continue
            if text.strip():
                log("vms> " + _clean(text)[-300:])
            if i is None:
                # a close means VMS is going down only if the shutdown had started (its %SHUTDOWN-I- messages) or the
                # last known question was answered; a close in the middle of the dialogue is a session that died
                if shutdown_started or last_answered == n - 1:
                    log("shutdown: VMS closed the connection (it is going down)")
                    return True
                log("shutdown: VMS closed the connection before the SHUTDOWN questions were all answered")
                return False
            if i == n:
                log("shutdown: VMS reports the shutdown is complete")
                return True
            if i == n + 1:
                if not shutdown_started:
                    log("shutdown: VMS has started the shutdown (its %SHUTDOWN-I- messages); waiting for it to finish")
                shutdown_started = True
                continue
            if i == n + 2:                           # a question this program does not know, with a default shown
                if shutdown_started:
                    continue
                if answered_unknown >= MAX_UNKNOWN:
                    log("shutdown: more than %d questions this program does not know: stopping, the VAX is left running"
                        % MAX_UNKNOWN)
                    return False
                rest = t.buf
                t.buf = ""                           # the rest of this line, if it is already here, is not a new question
                rest += t.read_quiet(t_settle, t_settle * 5)
                if rest.strip():
                    log("vms> " + _clean(rest)[-200:])
                log("vms< (the default: not a question this program knows)")
                try:
                    t.send("")
                except OSError as e:
                    log("shutdown: could not send the answer (%s): the session is gone" % e)
                    return False
                answered_unknown += 1
                continue
            # The question's key words have arrived, but its line may not be finished (cpvax: " node CPVAX [NO]? " still
            # to come): answering now sends the reply early.  Wait until VMS has been quiet for a moment.
            rest = t.buf
            t.buf = ""                               # whatever of this line is already here (" [0]: ") belongs to this question
            rest += t.read_quiet(t_settle, t_settle * 5)
            if rest.strip():
                log("vms> " + _clean(rest)[-200:])
            answer = SHUTDOWN_PROMPTS[i][1].format(minutes=minutes, reason=reason)
            log("vms< " + (answer or "(default)"))
            try:
                t.send(answer)
            except OSError as e:
                log("shutdown: could not send the answer (%s): the session is gone" % e)
                return False
            last_answered = max(last_answered, i)
    except socket.timeout as e:
        log("shutdown: timed out waiting for VMS (%s); transcript above. The VAX is left running." % e)
        # what VMS sent that matched nothing, with the escapes visible (a login procedure that asks a question, a
        # prompt that is not "$ ", terminal queries); the password is blanked in case anything echoed it
        pending = redact((seen + t.buf)[-500:])
        log("shutdown: text from VMS that matched nothing (last %d characters, escapes shown): %r" % (len(pending), pending))
        return False
    finally:
        t.close()


# ---------------------------------------------------------------- commands

def cmd_shutdown(cfg, args=None):
    if not unit_active(cfg):
        log("shutdown: %s is not running" % cfg["UNIT"])
        return 0
    cred = read_kv(cfg["CRED_FILE"])
    if not cred.get("VMS_USER") or not cred.get("VMS_PASSWORD"):
        log("shutdown: no VMS_USER / VMS_PASSWORD in %s: cannot do an orderly shutdown, so not stopping the VAX" % cfg["CRED_FILE"])
        return 3
    log("shutdown: asking VMS to shut down with the command %r (SHUTDOWN_WARN_MINUTES=%d applies only to the long "
        "@SYS$SYSTEM:SHUTDOWN dialogue)" % (cfg["SHUTDOWN_COMMAND"], cfg["SHUTDOWN_WARN_MINUTES"]))
    ok = vms_shutdown(cfg["VMS_HOST"], cfg["VMS_PORT"], cred["VMS_USER"], cred["VMS_PASSWORD"],
                      cfg["SHUTDOWN_WARN_MINUTES"], "Idle timeout (vax-ctl)", command=cfg["SHUTDOWN_COMMAND"])
    state = load_state()
    if not ok:
        state["retry_after"] = time.time() + cfg["SHUTDOWN_RETRY_MINUTES"] * 60
        save_state(state)
        log("shutdown: not stopping %s; will try again in %d minutes" % (cfg["UNIT"], cfg["SHUTDOWN_RETRY_MINUTES"]))
        return 1
    log("shutdown: VMS is down; stopping %s in %d s" % (cfg["UNIT"], cfg["SETTLE_SECONDS"]))
    time.sleep(cfg["SETTLE_SECONDS"])
    systemctl("stop", cfg["UNIT"])
    state.pop("retry_after", None)
    state.pop("idle_since", None)
    save_state(state)
    log("shutdown: %s is %s" % (cfg["UNIT"], "stopped" if not unit_active(cfg) else "STILL ACTIVE"))
    return 0 if not unit_active(cfg) else 1


def cmd_idle_check(cfg, args):
    if not unit_active(cfg):
        if not args.dry_run:
            save_state({})
        else:
            log("%s is not running: nothing to do" % cfg["UNIT"])
        return 0
    pid = main_pid(cfg)
    if not pid:
        return 0
    state = load_state()
    state, info = step(state, sample(cfg, pid), cfg)
    if not args.dry_run:                                   # a dry run reads, and does not keep the count
        save_state(state)
    elif info["busy"]:
        log("busy (%s): not idle" % info["why"])
    m = info["idle_min"]
    if m >= 1 and int(m) % 5 == 0 and abs(m - int(m)) < 1.0 / 60 * 1.5:
        log("idle for %d of %d minutes" % (m, cfg["IDLE_MINUTES"]))
    if info["busy"] or m < cfg["IDLE_MINUTES"]:
        return 0
    if state.get("retry_after", 0) > time.time():
        return 0
    if args.dry_run:
        log("idle for %.0f minutes (limit %d): would shut the VAX down" % (m, cfg["IDLE_MINUTES"]))
        return 0
    log("idle for %.0f minutes (limit %d): shutting the VAX down" % (m, cfg["IDLE_MINUTES"]))
    return cmd_shutdown(cfg)


PASS_TEXT = "Tests completed"
FAIL_TEXT = "Normal operation not possible"


def boot_verdict(text):
    """'passed' if the KA655 ROM printed `Tests completed.`, 'failed' if its self-test ended in `?53 ...  Normal
    operation not possible.`, None if neither is there (yet).  A pass wins if both are somehow present: a restart
    is only ever safe while no VMS can be running."""
    if PASS_TEXT in text:
        return "passed"
    if FAIL_TEXT in text:
        return "failed"
    return None


def boot_log_reset():
    """Empty the file that keeps what boot-watch read, for the console window to show (cpvax-term.sh)."""
    try:
        os.makedirs(os.path.dirname(BOOT_LOG), exist_ok=True)
        with open(BOOT_LOG, "w"):
            pass
        os.chmod(BOOT_LOG, 0o644)
    except OSError as e:
        log("boot-watch: cannot write %s: %s (carrying on without it)" % (BOOT_LOG, e))


def boot_log_add(text):
    try:
        with open(BOOT_LOG, "a", encoding="latin-1", newline="") as f:
            f.write(text.replace("\x1b[c", ""))            # not the terminal-identify query: a window would answer it
    except OSError:
        pass


def still_running(cfg, pid):
    return unit_active(cfg) and main_pid(cfg) == pid


def settle_boot_log(cfg, verdict, tm):
    """The VAX is staying up (the self-test passed, or retrying has stopped), so the next console client is the
    console window.  Measured on cpbee, a buffered simh console re-sends its whole buffer to every client that
    connects (not only the first); but if some build does not, the window needs the copy kept in BOOT_LOG.  Ask the
    console: connect once more, and if the text comes again the copy would only be printed twice, so empty it."""
    try:
        t = Telnet(cfg["CONSOLE_HOST"], cfg["CONSOLE_PORT"], 5)
        try:
            again = t.read_quiet(tm["replay_quiet"], tm["read_limit"])
        finally:
            t.close()
    except OSError as e:
        log("boot-watch: cannot ask the console whether it replays its text (%s): keeping the copy in %s" % (e, BOOT_LOG))
        return
    if boot_verdict(again) == verdict:
        log("boot-watch: the console sent the boot text again to a second client (%d characters): the console window "
            "sees it without help, so no copy is kept" % len(again))
        boot_log_reset()
    else:
        log("boot-watch: the console did not send the boot text again to a second client (%d characters): the copy "
            "in %s is for the console window" % (len(again), BOOT_LOG))


def cmd_boot_watch(cfg, args=None, timing=None):
    """Judge the ROM self-test of the simh process this unit has just started, from its console; restart the unit if
    it failed (the VAX then sits at >>> and no VMS is running), up to BOOT_RETRIES times in a row.  Exit status:
    0 passed / restarted / nothing to judge, 1 the restart did not go through, 2 no verdict, 3 gave up retrying."""
    tm = dict(BOOT_TIMING, **(timing or {}))
    unit = cfg["UNIT"]
    pid = main_pid(cfg) if unit_active(cfg) else 0
    if not pid:
        log("boot-watch: %s is not running: nothing to watch" % unit)
        return 0
    try:
        age = proc_age(pid)
    except (IOError, OSError, ValueError, IndexError):
        log("boot-watch: cannot read the age of pid %d" % pid)
        return 0
    if age > tm["give_up_age"]:
        log("boot-watch: simh (pid %d) is already %d s old: too late to judge a self-test, leaving it alone" % (pid, age))
        return 0
    boot = load_state(BOOT_STATE)
    if time.time() - boot.get("restarted_at", 0) > tm["restart_window"]:
        boot = {"restarts": 0}                      # not a restart of ours: a fresh power-on gets a fresh count
    log("boot-watch: pid %d is %d s old; will read the console at %d s (%d automatic restart(s) so far, %d allowed)"
        % (pid, age, tm["first_age"], boot.get("restarts", 0), cfg["BOOT_RETRIES"]))
    boot_log_reset()
    while age < tm["first_age"]:
        time.sleep(min(5.0, tm["first_age"] - age))
        if not still_running(cfg, pid):
            log("boot-watch: %s stopped or changed while waiting: nothing to do" % unit)
            return 0
        age = proc_age(pid)

    text, t, verdict = "", None, None
    while True:
        try:
            if t is None:
                t = Telnet(cfg["CONSOLE_HOST"], cfg["CONSOLE_PORT"], 5)
            text += t.read_quiet(tm["quiet"], tm["read_limit"], boot_log_add)
            if t.eof:
                t.close()
                t = None
        except OSError as e:
            log("boot-watch: console %s:%s: %s" % (cfg["CONSOLE_HOST"], cfg["CONSOLE_PORT"], e))
            if t:
                t.close()
            t = None
        verdict = boot_verdict(text)
        if verdict:
            break
        if not still_running(cfg, pid):
            log("boot-watch: %s stopped or changed before the self-test was judged: nothing to do" % unit)
            if t:
                t.close()
            return 0
        age = proc_age(pid)
        if age >= tm["give_up_age"]:
            break
        time.sleep(min(tm["again"], tm["give_up_age"] - age))
    if t:
        t.close()
    age = proc_age(pid) if still_running(cfg, pid) else 0

    if verdict == "passed":
        log("boot-watch: the ROM self-test passed (read at %d s): VMS is booting, nothing to do" % age)
        save_state({"restarts": 0, "result": "passed", "at": time.time()}, BOOT_STATE)
        settle_boot_log(cfg, verdict, tm)
        return 0
    if verdict is None:
        log("boot-watch: no verdict on the ROM self-test by %d s (%d characters read): leaving the VAX alone" % (age, len(text)))
        return 2
    n = boot.get("restarts", 0)
    if n >= cfg["BOOT_RETRIES"]:
        log("boot-watch: the ROM self-test failed (?53, Normal operation not possible) and %d automatic restart(s) did "
            "not help (BOOT_RETRIES=%d).  Giving up: the VAX is left at the >>> prompt.  No VMS is running, so "
            "`sudo systemctl restart %s` is safe." % (n, cfg["BOOT_RETRIES"], unit))
        save_state({"restarts": n, "restarted_at": 0, "result": "gave up", "at": time.time()}, BOOT_STATE)
        settle_boot_log(cfg, verdict, tm)
        return 3
    if not still_running(cfg, pid):
        log("boot-watch: %s stopped or changed since the self-test was read: not restarting it" % unit)
        return 0
    n += 1
    save_state({"restarts": n, "restarted_at": time.time(), "result": "failed", "at": time.time()}, BOOT_STATE)
    log("boot-watch: the ROM self-test failed (?53, Normal operation not possible), read at %d s: restarting %s "
        "(automatic restart %d of %d)" % (age, unit, n, cfg["BOOT_RETRIES"]))
    r = systemctl("--no-block", "restart", unit)
    if r.returncode != 0:
        log("boot-watch: systemctl restart %s failed: %s" % (unit, r.stderr.strip()))
        return 1
    return 0


def cmd_status(cfg, args):
    on = unit_active(cfg)
    print("unit %s: %s" % (cfg["UNIT"], "running" if on else "stopped"))
    if not on:
        return 0
    print("OpenVMS telnet %s:%s: %s" % (cfg["VMS_HOST"], cfg["VMS_PORT"], "answers" if port_open(cfg["VMS_HOST"], cfg["VMS_PORT"]) else "not answering"))
    st = load_state()
    if st.get("idle_since"):
        print("idle for %.0f of %d minutes" % ((time.time() - st["idle_since"]) / 60.0, cfg["IDLE_MINUTES"]))
    else:
        print("busy, or not yet judged (limit: %d idle minutes)" % cfg["IDLE_MINUTES"])
    b = load_state(BOOT_STATE)
    if b.get("result"):
        print("boot self-test: %s %.0f minutes ago; %d automatic restart(s) in this run of failures (limit %d)"
              % (b["result"], (time.time() - b.get("at", 0)) / 60.0, b.get("restarts", 0), cfg["BOOT_RETRIES"]))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("status")
    p = sub.add_parser("idle-check")
    p.add_argument("--dry-run", action="store_true")
    sub.add_parser("shutdown")
    sub.add_parser("boot-watch")
    args = ap.parse_args(argv)
    cfg = load_conf()
    fn = {"status": cmd_status, "idle-check": cmd_idle_check, "shutdown": lambda c, a: cmd_shutdown(c),
          "boot-watch": cmd_boot_watch}.get(args.cmd)
    if not fn:
        ap.print_help()
        return 2
    return fn(cfg, args)


if __name__ == "__main__":
    sys.exit(main())
