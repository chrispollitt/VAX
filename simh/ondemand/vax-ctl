# on, and gives up at `give_up_age`.  A restart it made counts as its own for `restart_window` afterwards.
# `replay_quiet`: how long a second connection, made to see whether the console re-sends the text, waits for it.
BOOT_TIMING = {"first_age": 58.0, "quiet": 4.0, "read_limit": 15.0, "again": 15.0, "give_up_age": 120.0,
               "restart_window": 300.0, "replay_quiet": 1.5}

